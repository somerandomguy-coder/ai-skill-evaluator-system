# --- Database -----------------------------------------------------------------
# Local dev: `docker compose up -d db` starts Postgres on port 54329.
# Production (Supabase Session Pooler on port 5432 or Transaction Pooler on 6543):
DATABASE_URL="postgresql://assess:assess@localhost:54329/assess_dev?schema=public"

# --- AI Provider Selector -----------------------------------------------------
# Options: "openai" | "deepseek" | "custom"
# Default: "openai" (or automatically "deepseek" if DEEPSEEK_API_KEY is present and OPENAI_API_KEY is empty)
AI_PROVIDER="openai"

# --- OpenAI Configuration -----------------------------------------------------
OPENAI_API_KEY=""
# Recommended OpenAI models:
#   Fast / Low Latency (Workspace Chat): "gpt-4o-mini"
#   Flagship General / Code Gen:         "gpt-4o"
#   Frontier Reasoning / Evaluation:     "o3-mini" or "o3"
OPENAI_MODEL="gpt-4o"

# Stage-specific overrides for OpenAI (optional):
# OPENAI_MODEL_PARSE="gpt-4o-mini"
# OPENAI_MODEL_RESEARCH="gpt-4o-mini"
# OPENAI_MODEL_CHALLENGE="o3-mini"
# OPENAI_MODEL_ASSISTANT="gpt-4o-mini"
# OPENAI_MODEL_EVALUATOR="gpt-4o"

# --- DeepSeek Configuration ---------------------------------------------------
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# Recommended DeepSeek models:
#   Fast Chat & Coding (Workspace Chat): "deepseek-chat" (or "deepseek-flash" / "deepseek-v4-flash")
#   Deep Reasoning & Math / Evaluation:  "deepseek-reasoner" (or "deepseek-v4-pro")
DEEPSEEK_MODEL="deepseek-chat"

# Stage-specific overrides for DeepSeek (optional):
# DEEPSEEK_MODEL_PARSE="deepseek-chat"
# DEEPSEEK_MODEL_RESEARCH="deepseek-chat"
# DEEPSEEK_MODEL_CHALLENGE="deepseek-chat"
# DEEPSEEK_MODEL_ASSISTANT="deepseek-chat"
# DEEPSEEK_MODEL_EVALUATOR="deepseek-reasoner"

# --- Demo mode ----------------------------------------------------------------
# true  => NO live API or search calls. AI + search are served from cached
#          fixtures so the whole flow runs offline (use this on stage).
# false => live AI + DuckDuckGo (search results are cached in Postgres).
DEMO_MODE="false"

# --- WebContainer -------------------------------------------------------------
# Optional. @webcontainer/api needs a licence/API key for commercial production
# use; localhost development works without one. Public by design (browser SDK).
NEXT_PUBLIC_WEBCONTAINER_API_KEY=""

# --- Langfuse Observability & Tracing -----------------------------------------
# Optional. Traces user messages, prompts, completions, tokens, latency & evaluations.
# Sign up at https://cloud.langfuse.com (or self-hosted) -> Settings -> API Keys.
# If keys are omitted, tracking safely turns into a no-op with zero overhead.
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_BASEURL="https://cloud.langfuse.com" # or "https://us.cloud.langfuse.com"
