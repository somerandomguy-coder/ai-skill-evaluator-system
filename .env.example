# --- Database -----------------------------------------------------------------
# Local dev: `docker compose up -d db` starts Postgres on port 54329.
DATABASE_URL="postgresql://assess:assess@localhost:54329/assess?schema=public"

# --- Anthropic ----------------------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ — the key must not reach the client.
ANTHROPIC_API_KEY=""

# Model per pipeline stage. All default to claude-opus-5; override to trade
# quality for cost/latency (e.g. claude-sonnet-5 for the build assistant).
# ANTHROPIC_MODEL="claude-opus-5"
# ANTHROPIC_MODEL_PARSE=""
# ANTHROPIC_MODEL_RESEARCH=""
# ANTHROPIC_MODEL_CHALLENGE=""
# ANTHROPIC_MODEL_ASSISTANT=""
# ANTHROPIC_MODEL_EVALUATOR=""

# Server-side refusal fallbacks (beta `server-side-fallback-2026-07-01`).
# "default" re-runs a request the safety classifier declined on Anthropic's
# recommended fallback model. Set to "off" to use the plain GA endpoint.
ANTHROPIC_REFUSAL_FALLBACKS="default"

# --- Demo mode ----------------------------------------------------------------
# true  => NO live API or search calls. AI + search are served from cached
#          fixtures so the whole flow runs offline (use this on stage).
# false => live Anthropic + DuckDuckGo (search results are cached in Postgres).
DEMO_MODE="true"

# --- WebContainer -------------------------------------------------------------
# Optional. @webcontainer/api needs a licence/API key for commercial production
# use; localhost development works without one. Public by design (browser SDK).
NEXT_PUBLIC_WEBCONTAINER_API_KEY=""
