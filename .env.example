# --- Database -----------------------------------------------------------------
# Local dev: `docker compose up -d db` starts Postgres on port 54329.
DATABASE_URL="postgresql://assess:assess@localhost:54329/assess_dev?schema=public"

# --- OpenAI -------------------------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ — the key must not reach the client.
OPENAI_API_KEY=""

# Model per pipeline stage. All default to gpt-5.5; override to trade
# quality for cost/latency (e.g. gpt-5.4-mini for the build assistant).
# OPENAI_MODEL="gpt-5.5"
# OPENAI_MODEL_PARSE=""
# OPENAI_MODEL_RESEARCH=""
# OPENAI_MODEL_CHALLENGE=""
# OPENAI_MODEL_ASSISTANT=""
# OPENAI_MODEL_EVALUATOR=""

# --- Demo mode ----------------------------------------------------------------
# true  => NO live API or search calls. AI + search are served from cached
#          fixtures so the whole flow runs offline (use this on stage).
# false => live OpenAI + DuckDuckGo (search results are cached in Postgres).
DEMO_MODE="true"

# --- WebContainer -------------------------------------------------------------
# Optional. @webcontainer/api needs a licence/API key for commercial production
# use; localhost development works without one. Public by design (browser SDK).
NEXT_PUBLIC_WEBCONTAINER_API_KEY=""

# --- Langfuse Observability & Tracing -----------------------------------------
# Optional. Traces user messages, prompts, completions, tokens, latency & evaluations.
# Sign up at https://cloud.langfuse.com (or self-hosted) -> Settings -> API Keys.
# If keys are omitted, tracking safely turns into a no-op with zero overhead.
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_BASEURL="https://cloud.langfuse.com" # or "https://us.cloud.langfuse.com"

# --- Supabase (Production Database) -------------------------------------------
# Supabase Transaction Pooler URL (recommended for Vercel Serverless / Next.js):
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

