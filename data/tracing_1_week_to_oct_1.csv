, \""domain.duplicateEvent\"");\n  }\n\n  if (normalized.workflowId && normalized.workflowId === normalized.eventId) {\n    pushError(errors, \""workflowId\"", \""Workflow ID must not be identical to event ID.\"", \""domain.workflowScope\"");\n  }\n\n  const occurredMs = Date.parse(normalized.occurredAt);\n  if (!isRealUtcInstant(normalized.occurredAt)) {\n    pushError(errors, \""occurredAt\"", \""Timestamp must be a real UTC ISO-8601 instant.\"", \""time.invalid\"");\n  } else {\n    const fiveMinutesMs = 5 * 60 * 1000;\n    if (occurredMs > now.getTime() + fiveMinutesMs) {\n      pushError(errors, \""occurredAt\"", \""Timestamp cannot be more than five minutes in the future.\"", \""time.future\"");\n    }\n    if (occurredMs < Date.UTC(2000, 0, 1)) {\n      pushError(errors, \""occurredAt\"", \""Timestamp is outside the accepted business retention window.\"", \""time.tooOld\"");\n    }\n  }\n\n  if (normalized.type === \""TRADE_APPROVAL_REQUESTED\"" && normalized.subject.entityType !== \""trade\"") {\n    pushError(errors, \""subject.entityType\"", \""Trade approval events must be scoped to a trade subject.\"", \""domain.subjectScope\"");\n  }\n\n  if (normalized.type === \""SETTLEMENT_EXCEPTION\"" && ![\""order\"", \""trade\""].includes(normalized.subject.entityType)) {\n    pushError(errors, \""subject.entityType\"", \""Settlement exceptions must be scoped to an order or trade subject.\"", \""domain.subjectScope\"");\n  }\n\n  if (normalized.type === \""ACCESS_REVIEW\"" && normalized.payload.classification !== \""restricted\"") {\n    pushError(errors, \""payload.classification\"", \""Access review events must be classified as restricted.\"", \""domain.classification\"");\n  }\n\n  return {\n    valid: errors.length === 0,\n    errors,\n    value: errors.length === 0 ? normalized : null,\n  };\n}\n\nexport function maskName(value) {\n  return value\n    .split(/\\s+/)\n    .filter(Boolean)\n    .map((part) => `${part.slice(0, 1).toUpperCase()}…`)\n    .join(\""