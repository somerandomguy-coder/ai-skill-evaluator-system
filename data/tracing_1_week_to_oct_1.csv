%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/gi`. Good.\n\nNeed validation email regex maybe same.\n\nNow UI. Use controlled textarea. sample event:\n{\n  \""eventType\"": \""support_ticket\"",\n  \""eventId\"": \""evt_001\"",\n  \""customerEmail\"": \""jane.doe@example.com\"",\n  \""customerName\"": \""Jane Doe\"",\n  \""phone\"": \""0412 345 678\"",\n  \""nationalId\"": \""123 456 782\"",\n  \""description\"": \""Customer called from 02 9999 8888 and asked to update contact to jane.doe@example.com. TFN: 123 456 782.\"",\n  \""priority\"": \""high\""\n}\nThis demonstrates multiple PII. On process, should validate then mask email/phone/nationalId entire fields; description scan masks phone, email, TFN. Good.\n\nBut note `nationalId` field strict? We use broad.\n\nNeed maybe Add sample button fills textarea.\n\nPersisted events: store array `events`. `handleProcess`:\n- parse JSON from textarea; if parse error, set errors [{path:\""input\"", reason:\""Invalid JSON: ...\""}].\n- processEvent(parsed)\n- if ok:\n   const eventWithMeta = { ...result.event, persistedAt: new Date().toISOString() };\n   setEvents(prev => [eventWithMeta, ...prev]);\n   setLastResult(result.event)\n   setErrors([])\n- else setErrors(result.errors) and no persistence.\nNeed display persisted events with masked PII. The event in state is sanitized; when displayed using JSON.stringify, should show no PII.\n\nCould include a \""Raw input\"" not stored.\n\nObservability: show \""Validation report\"" red/green.\n\nNeed data scoping UI: maybe show allowed fields for each event type. Could render static schema summary:\n- support_ticket: eventType, eventId, customerEmail*, customerName, phone, nationalId, description*, priority\n- employee_update, incident_report.\nWe'll include in info.\n\nNeed maybe no backend. All local.\n\nNow create files. We'll create `src/workflow/schema.js`, `src/workflow/sanitizer.js`, `src/workflow/processEvent.js` maybe combine. Keep under 300 lines each.\n\nLet's write `src/workflow/schema.js` exports EVENT_SCHEMA and EVENT_TYPES. It may include regex constants.\n\n`src/workflow/sanitizer.js` exports maskEmail, maskPhone, maskNationalId, scanAndMaskPii, sanitizeEvent. Need sanitizeEvent uses schema.\n\n`src/workflow/processEvent.js` exports processEvent.\n\nCould combine sanitizer and process in one file to reduce. But readability okay.\n\nLet's design `schema.js`:\nexport const EVENT_TYPES = {\n  support_ticket: \""Support ticket\"",\n  employee_update: \""Employee update\"",\n  incident_report: \""Incident report\""\n};\nexport const PRIORITY_VALUES = [\""low\"", \""medium\"", \""high\"", \""critical\""];\nexport const EVENT_SCHEMA = {\n  support_ticket: {\n    required: [\""eventType\"",\""eventId\"",\""customerEmail\"",\""description\""],\n    fields: {\n      eventType: { type: \""enum\"", values: [\""support_ticket\""] },\n      eventId: { type: \""string\"", maxLength: 64 },\n      customerEmail: { type: \""email\"", maxLength: 254 },\n      customerName: { type: \""string\"", maxLength: 120 },\n      phone: { type: \""phone\"" },\n      nationalId: { type: \""nationalId\"" },\n      description: { type: \""string\"", maxLength: 1000, scanPii: true },\n      priority: { type: \""enum\"", values: PRIORITY_VALUES }\n    }\n  },\n  employee_update: {\n    required: [\""eventType\"",\""eventId\"",\""employeeEmail\"",\""fullName\""],\n    fields: {\n      eventType: { type: \""enum\"", values: [\""employee_update\""] },\n      eventId: { type: \""string\"", maxLength: 64 },\n      employeeEmail: { type: \""email\"", maxLength: 254 },\n      fullName: { type: \""string\"", maxLength: 120 },\n      phone: { type: \""phone\"" },\n      nationalId: { type: \""nationalId\"" },\n      note: { type: \""string\"", maxLength: 1000, scanPii: true },\n      role: { type: \""string\"", maxLength: 80 }\n    }\n  },\n  incident_report: {\n    required: [\""eventType\"",\""eventId\"",\""reporterEmail\"",\""summary\""],\n    fields: {\n      eventType: { type: \""enum\"", values: [\""incident_report\""] },\n      eventId: { type: \""string\"", maxLength: 64 },\n      reporterEmail: { type: \""email\"", maxLength: 254 },\n      reporterPhone: { type: \""phone\"" },\n      reporterNationalId: { type: \""nationalId\"" },\n      summary: { type: \""string\"", maxLength: 2000, scanPii: true },\n      severity: { type: \""enum\"", values: [\""minor\"",\""major\"",\""critical\""] }\n    }\n  }\n};\n\nNeed emailRegex exported for validation? Maybe put in schema or separate. We'll define in schema.js:\nexport const EMAIL_REGEX = /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}$/i;\nexport const AUSTRALIAN_PHONE_REGEX = /.../? For validation we need anchored. We can use phone regex without g for test. Use:\nexport const PHONE_PATTERN = /^(?:(?:\\+?61[ -]?|0)4\\d{2}[ -]?\\d{3}[ -]?\\d{3}|(?:\\+?61[ -]?|0)[2378][ -]?\\d{4}[ -]?\\d{4})$/;\nBut need allow optional plus? We'll include.\n\nNationalId pattern broad: /^[A-Za-z0-9][A-Za-z0-9\\s-]{5,19}$/ maybe.\n\n`sanitizer.js` imports schema, regex patterns and defines scanning. It can use regex constants from schema? We'll export broad `AUSTRALIAN_PHONE_LOOSE_REGEX` maybe. Simpler define in sanitizer.\n\n`sanitizer.js`:\nimport { EVENT_SCHEMA } from \""./schema.js\"";\n\nconst EMAIL_LOOSE_REGEX = /\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/gi;\nconst PHONE_LOOSE_REGEX = /(?:(?:\\+?61[ -]?|0)4\\d{2}[ -]?\\d{3}[ -]?\\d{3})|(?:(?:\\+?61[ -]?|0)[2378][ -]?\\d{4}[ -]?\\d{4})\\b/g; // good\nconst TFN_LOOSE_REGEX = /(?:\\bTFN\\b|\\btax file number\\b)[\\s:]*\\d{3}[\\s-]?\\d{3}[\\s-]?\\d{3}\\b/gi;\nconst MEDICARE_LOOSE_REGEX = /(?:\\bmedicare\\b|\\bmedicare number\\b)[\\s:]*\\d{4}[\\s-]?\\d{5}[\\s-]?\\d{1}\\b/gi;\nconst DRIVER_LICENCE_LOOSE_REGEX = /(?:\\bdriver'?s? licence\\b|\\bdriver license\\b)[\\s:]*[a-z0-9]{6,12}\\b/gi;\n\nexport function maskEmail() { return \""***@***.***\""; } // maybe no arg\nexport function maskPhone() { return \""(masked) 04** *** ***\""; } Better maybe \""04** *** ***\"" but constant.\nUse \""*** *** ***\"". Let's use constants:\nEMAIL_MASK = \""***@***.***\""\nPHONE_MASK = \""*** *** ***\""\nNATIONAL_ID_MASK = \""***-***-***\""\n\nexport function scanAndMaskPii(input) {\n  if (typeof input !== \""string\"") return input;\n  return input\n    .replace(EMAIL_LOOSE_REGEX, EMAIL_MASK)\n    .replace(PHONE_LOOSE_REGEX, PHONE_MASK)\n    .replace(TFN_LOOSE_REGEX, NATIONAL_ID_MASK)\n    .replace(MEDICARE_LOOSE_REGEX, NATIONAL_ID_MASK)\n    .replace(DRIVER_LICENCE_LOOSE_REGEX, NATIONAL_ID_MASK);\n}\n\nexport function sanitizeEvent(event) {\n  const schema = EVENT_SCHEMA[event.eventType];\n  const sanitized = { ...event };\n  for (const [key, spec] of Object.entries(schema.fields)) {\n    if (sanitized[key] === undefined) continue;\n    if (spec.type === \""email\"") sanitized[key] = maskEmail();\n    else if (spec.type === \""phone\"") sanitized[key] = maskPhone();\n    else if (spec.type === \""nationalId\"") sanitized[key] = NATIONAL_ID_MASK;\n    else if (spec.scanPii) sanitized[key] = scanAndMaskPii(sanitized[key]);\n  }\n  return sanitized;\n}\nNeed note dedup: if phone regex masks phone in description, okay.\n\n`processEvent.js`:\nimport { EVENT_SCHEMA, EMAIL_REGEX, PHONE_PATTERN, NATIONAL_ID_PATTERN } from \""./schema.js\"";\nimport { sanitizeEvent } from \""./sanitizer.js\"";\n\nexport function processEvent(raw) {\n  const errors = [];\n  if (!raw || typeof raw !== \""object\"" || Array.isArray(raw)) {\n    return { ok: false, errors: [{ path: \""input\"", reason: \""Payload must be a JSON object.\"" }] };\n  }\n  const eventType = raw.eventType;\n  if (typeof eventType !== \""string\"") {\n    return { ok: false, errors: [{ path: \""eventType\"", reason: \""eventType is required and must be a string.\"" }] };\n  }\n  const schema = EVENT_SCHEMA[eventType];\n  if (!schema) {\n    return { ok: false, errors: [{ path: \""eventType\"", reason: `eventType must be one of: ${Object.keys(EVENT_SCHEMA).join(\"", \"")}.` }] };\n  }\n\n  // Strict data scoping: unknown fields are not allowed.\n  for (const key of Object.keys(raw)) {\n    if (!(key in schema.fields)) {\n      errors.push({ path: key, reason: `Field \""${key}\"" is not allowed for event type \""${eventType}\"".` });\n    }\n  }\n\n  for (const fieldName of schema.required) {\n    if (raw[fieldName] === undefined) {\n      errors.push({ path: fieldName, reason: `Field \""${fieldName}\"" is required.` });\n    }\n  }\n\n  for (const [fieldName, value] of Object.entries(raw)) {\n    const spec = schema.fields[fieldName];\n    if (!spec) continue; // unknown handled\n    if (value === undefined) continue;\n    if (value === null) { errors.push({ path: fieldName, reason: `Field \""${fieldName}\"" cannot be null.` }); continue; }\n    switch (spec.type) {\n      case \""string\"":\n        if (typeof value !== \""string\"") { errors.push({ path: fieldName, reason: `Field \""${fieldName}\"" must be a string.` }); continue; }\n        if (spec.maxLength && value.length > spec.maxLength) { errors.push({ path: fieldName, reason: `Field \""${fieldName}\"" exceeds ${spec.maxLength} characters.` }); }\n        break;\n      case \""email\"":\n        if (typeof value !== \""string\"" || !EMAIL_REGEX.test(value.trim())) { errors.push({ path: fieldName, reason: `Field \""${fieldName}\"" must be a valid email address.` }); continue; }\n        if (spec.maxLength && value.length > spec.maxLength) { errors.push({ path: fieldName, reason: `Field \""${fieldName}\"" exceeds ${spec.maxLength} characters.` }); }\n        break;\n      case \""phone\"":\n        if (typeof value !== \""string\"" || !PHONE_PATTERN.test(value.trim())) { errors.push({ path: fieldName, reason: `Field \""${fieldName}\"" must be a valid Australian phone number (e.g. 0412 345 678 or 02 9999 8888).` }); continue; }\n        break;\n      case \""nationalId\"":\n        if (typeof value !== \""string\"" || !NATIONAL_ID_PATTERN.test(value.trim())) { errors.push({ path: fieldName, reason: `Field \""${fieldName}\"" must be a valid national identifier string.` }); continue; }\n        break;\n      case \""enum\"":\n        if (typeof value !== \""string\"" || !spec.values.includes(value)) { errors.push({ path: fieldName, reason: `Field \""${fieldName}\"" must be one of: ${spec.values.join(\"", \"")}.` }); }\n        break;\n      default:\n        break;\n    }\n  }\n\n  if (errors.length > 0) return { ok: false, errors };\n\n  const sanitized = sanitizeEvent(raw);\n  return { ok: true, event: sanitized };\n}\n\nNeed ensure required check includes eventType? If eventType missing we already handle. But if eventType present and not string? Earlier got error and returned; but if raw has eventType non-string, we return. Good. Then required not needed for eventType but okay.\n\nPotential issue: if raw has `eventType` valid but required missing, we collect. Good.\n\n`App.jsx`:\nimport { useState } from \""react\"";\nimport { processEvent } from \""./workflow/processEvent.js\"";\nimport { EVENT_SCHEMA } from \""./workflow/schema.js\"";\n\nexport default function App() {\n  const [input, setInput] = useState(\""\"");\n  const [errors, setErrors] = useState([]);\n  const [events, setEvents] = useState([]);\n  const [lastSanitized, setLastSanitized] = useState(null);\n\n  const sample = `{ ... }`; // string\n\n  function handleProcess() {\n    setErrors([]);\n    setLastSanitized(null);\n    let parsed;\n    try { parsed = JSON.parse(input); }\n    catch (err) { setErrors([{ path:\""input\"", reason:`Invalid JSON: ${err.message}` }]); return; }\n    const result = processEvent(parsed);\n    if (!result.ok) { setErrors(result.errors); return; }\n    const persisted = { ...result.event, persistedAt: new Date().toISOString() };\n    setEvents(prev => [persisted, ...prev]);\n    setLastSanitized(result.event);\n    setInput(\""\""); // optional maybe keep? If clear, candidate can inspect? Better keep input? We'll clear on success and show success. Could keep for 