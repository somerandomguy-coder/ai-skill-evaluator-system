sion: \""jump-trading.workflow-event.v1\"",\n      receivedAt: now.toISOString(),\n      storedEvent: maskedEvent,\n      audit: {\n        privacyLaw: \""Australian Privacy Act 1988\"",\n        validationMode: \""strict-schema-boundary\"",\n        rawInputPersisted: false,\n        maskingApplied,\n      },\n    },\n  };\n}\n\nexport const schemaReference = {\n  eventTypes: EVENT_TYPES,\n  subjectTypes: SUBJECT_TYPES,\n  classifications: CLASSIFICATIONS,\n  requiredTopLevelFields: TOP_LEVEL_KEYS,\n};\n\n\n=== src/styles.css ===\n:root {\n  font-family:\n    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \""Segoe UI\"", sans-serif;\n  color: #172033;\n  background: #f4f7fb;\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n}\n\nbutton,\ntextarea {\n  font: inherit;\n}\n\n.shell {\n  width: min(1180px, calc(100% - 32px));\n  margin: 0 auto;\n  padding: 40px 0;\n}\n\n.hero {\n  margin-bottom: 28px;\n}\n\n.eyebrow {\n  margin: 0 0 10px;\n  color: #2f65cb;\n  font-size: 0.78rem;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.hero h1 {\n  max-width: 860px;\n  margin: 0;\n  color: #101828;\n  font-size: clamp(2rem, 5vw, 4.4rem);\n  line-height: 0.96;\n  letter-spacing: -0.06em;\n}\n\n.hero p:last-child {\n  max-width: 820px;\n  margin: 18px 0 0;\n  color: #526070;\n  font-size: 1.05rem;\n  line-height: 1.7;\n}\n\n.grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.8fr);\n  gap: 18px;\n  align-items: start;\n}\n\n.panel {\n  border: 1px solid #dce3ee;\n  border-radius: 22px;\n  background: rgba(255, 255, 255, 0.92);\n  box-shadow: 0 18px 48px rgba(31, 42, 68, 0.08);\n  padding: 22px;\n}\n\n.panel + .panel {\n  margin-top: 18px;\n}\n\n.panel-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 14px;\n}\n\n.panel h2,\n.panel h3 {\n  margin: 0;\n  color: #101828;\n}\n\n.panel h2 {\n  font-size: 1.08rem;\n}\n\n.panel h3 {\n  font-size: 0.95rem;\n}\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  min-height: 28px;\n  border-radius: 999px;\n  background: #eef4ff;\n  color: #2f65cb;\n  padding: 5px 10px;\n  font-size: 0.78rem;\n  font-weight: 800;\n  white-space: nowrap;\n}\n\n.badge.success {\n  background: #e9f9ef;\n  color: #087443;\n}\n\n.composer textarea {\n  width: 100%;\n  min-height: 510px;\n  resize: vertical;\n  border: 1px solid #c9d4e4;\n  border-radius: 16px;\n  outline: none;\n  background: #0c1222;\n  color: #dbeafe;\n  padding: 16px;\n  font-family: \""SFMono-Regular\"", Consolas, \""Liberation Mono\"", monospace;\n  font-size: 0.9rem;\n  line-height: 1.55;\n}\n\n.composer textarea:focus {\n  border-color: #2f65cb;\n  box-shadow: 0 0 0 4px rgba(47, 101, 203, 0.14);\n}\n\n.actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-top: 14px;\n}\n\nbutton {\n  border: 0;\n  border-radius: 12px;\n  background: #1d4ed8;\n  color: white;\n  cursor: pointer;\n  font-weight: 800;\n  padding: 11px 14px;\n}\n\nbutton:hover {\n  background: #1e40af;\n}\n\nbutton.secondary {\n  border: 1px solid #c9d4e4;\n  background: white;\n  color: #263449;\n}\n\nbutton.secondary:hover {\n  background: #f6f9fd;\n}\n\n.assurance ul {\n  margin: 14px 0 0;\n  padding-left: 20px;\n  color: #435166;\n  line-height: 1.65;\n}\n\n.schema-box {\n  margin-top: 18px;\n  border-radius: 16px;\n  background: #f7faff;\n  padding: 16px;\n}\n\n.schema-box p {\n  margin: 10px 0 0;\n  color: #435166;\n  line-height: 1.5;\n}\n\npre {\n  max-height: 520px;\n  overflow: auto;\n  margin: 0;\n  border-radius: 16px;\n  background: #0c1222;\n  color: #dbeafe;\n  padding: 16px;\n  font-family: \""SFMono-Regular\"", Consolas, \""Liberation Mono\"", monospace;\n  font-size: 0.83rem;\n  line-height: 1.55;\n}\n\n.success-panel {\n  border-color: #b7ebc6;\n}\n\n.error-panel {\n  border-color: #fecaca;\n  background: #fffafa;\n}\n\n.error-list {\n  display: grid;\n  gap: 10px;\n  margin: 14px 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.error-list li {\n  display: grid;\n  grid-template-columns: minmax(120px, 0.4fr) minmax(0, 1fr) auto;\n  gap: 12px;\n  align-items: start;\n  border: 1px solid #fee2e2;\n  border-radius: 14px;\n  background: white;\n  padding: 12px;\n}\n\n.error-list strong {\n  color: #991b1b;\n}\n\n.error-list span {\n  color: #4b5563;\n}\n\ncode {\n  border-radius: 999px;\n  background: #fff1f2;\n  color: #be123c;\n  padding: 3px 8px;\n  font-size: 0.78rem;\n  font-weight: 800;\n}\n\n.record-list {\n  display: grid;\n  gap: 14px;\n}\n\n.record-card {\n  display: grid;\n  gap: 12px;\n}\n\n.record-card > div {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 12px;\n  align-items: center;\n  color: #526070;\n}\n\n.record-card strong {\n  color: #101828;\n}\n\n.muted {\n  margin: 0;\n  color: #687589;\n}\n\n@media (max-width: 900px) {\n  .grid {\n    grid-template-columns: 1fr;\n  }\n\n  .composer textarea {\n    min-height: 420px;\n  }\n\n  .error-list li {\n    grid-template-columns: 1fr;\n  }\n}\n\n\n=== vite.config.js ===\nimport { defineConfig } from \""vite\"";\n\n// No @vitejs/plugin-react on purpose: esbuild compiles JSX, which keeps\n// `npm install` fast inside the browser sandbox.\nexport default defineConfig({\n  esbuild: { jsx: \""automatic\"" },\n});\n\n</files>\n\nEvaluate now. Return every requirement id exactly once.""}]}","","{""response_format"":""{\""type\"":\""json_schema\"",\""json_schema\"":{\""name\"":\""evaluator_output\"",\""strict\"":true,\""schema\"":{\""$schema\"":\""http://json-schema.org/draft-07/schema#\"",\""type\"":\""object\"",\""properties\"":{\""perRequirement\"":{\""type\"":\""array\"",\""items\"":{\""type\"":\""object\"",\""properties\"":{\""requirementId\"":{\""type\"":\""string\""},\""score\"":{\""anyOf\"":[{\""type\"":\""integer\"",\""minimum\"":-9007199254740991,\""maximum\"":9007199254740991},{\""type\"":\""null\""}