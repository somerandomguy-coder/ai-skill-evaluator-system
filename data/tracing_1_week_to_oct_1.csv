.\""},\""niceToHaveSkills\"":{\""type\"":\""array\"",\""items\"":{\""type\"":\""string\""}},\""barriers\"":{\""type\"":\""array\"",\""items\"":{\""type\"":\""object\"",\""properties\"":{\""text\"":{\""type\"":\""string\"",\""description\"":\""The requirement, quoted verbatim from the job description.\""},\""kind\"":{\""type\"":\""string\"",\""enum\"":[\""LOCAL_EXPERIENCE\"",\""WORK_RIGHTS_OR_RESIDENCY\"",\""CREDENTIAL_GATE\"",\""PEDIGREE_PROXY\"",\""CULTURE_FIT_PROXY\"",\""NATIVE_LANGUAGE\"",\""YEARS_OF_EXPERIENCE\"",\""OTHER\""]},\""reason\"":{\""type\"":\""string\"",\""description\"":\""One sentence: why this filters people rather than measuring the ability to do the job.\""}},\""required\"":[\""text\"",\""kind\"",\""reason\""],\""additionalProperties\"":false},\""description\"":\""Requirements that look like barriers rather than genuine needs (local experience, residency, degree/pedigree gates, culture-fit proxies, native-speaker requirements, years-served proxies). They are excluded from the rubric.\""}},\""required\"":[\""roleTitle\"",\""seniority\"",\""employer\"",\""location\"",\""domain\"",\""teamContext\"",\""mustHaveSkills\"",\""niceToHaveSkills\"",\""barriers\""],\""additionalProperties\"":false}}}"",""maxTokens"":""8000"",""effort"":""low"",""stage"":""parse""}","","","[""parse""]","7056675e1aaa63a8f50d00f789783e123c2eb2cb","","[]"
